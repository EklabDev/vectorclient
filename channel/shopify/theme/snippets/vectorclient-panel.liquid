{% comment %}
  VectorClient panel snippet.
  Usage: {% render 'vectorclient-panel', title: 'Ask us' %}

  Configure in Theme settings / app metafields:
  - vectorclient_proxy_path (recommended): e.g. /apps/vectorclient/invoke
  - vectorclient_endpoint_id, vectorclient_user_id (optional display only)
  - theme colors

  Do NOT put the API key in theme settings. Use an App Proxy that adds x-api-key server-side.
{% endcomment %}

{% assign vc_proxy = settings.vectorclient_proxy_path | default: '/apps/vectorclient/invoke' %}
{% assign vc_primary = settings.vectorclient_primary_color | default: '#0f766e' %}
{% assign vc_surface = settings.vectorclient_surface_color | default: '#ffffff' %}
{% assign vc_text = settings.vectorclient_text_color | default: '#0f172a' %}
{% assign vc_radius = settings.vectorclient_border_radius | default: '8px' %}
{% assign vc_font = settings.vectorclient_font_family | default: 'Source Sans 3, Helvetica Neue, sans-serif' %}

<div
  class="vc-panel"
  data-vc-shopify-panel
  data-proxy-url="{{ vc_proxy }}"
  style="--vc-primary: {{ vc_primary }}; --vc-surface: {{ vc_surface }}; --vc-text: {{ vc_text }}; --vc-radius: {{ vc_radius }}; --vc-font: {{ vc_font }};"
>
  <h3 class="vc-panel__title">{{ title | default: 'VectorClient' }}</h3>
  <form class="vc-panel__form" data-vc-form>
    <textarea
      class="vc-panel__input"
      name="payload"
      rows="5"
    >{"message":"Hello from Shopify","product_id":"{{ product.id | default: '' }}"}</textarea>
    <button class="vc-panel__submit" type="submit">{{ submit_label | default: 'Send' }}</button>
  </form>
  <p class="vc-panel__error" data-vc-error hidden></p>
  <pre class="vc-panel__result" data-vc-result hidden></pre>
</div>

{{ 'vectorclient-panel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vectorclient-panel.js' | asset_url }}" defer></script>
