{
  "name": "@vectorclient/channel-shared",
  "version": "1.0.0",
  "description": "Shared VectorClient channel SDK — config, theme, and gateway client",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
