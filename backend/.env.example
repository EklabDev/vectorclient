# ArcadeDB (HTTP, internal Compose network in Docker)
ARCADEDB_URL=http://localhost:2480
ARCADEDB_USER=root
ARCADEDB_PASSWORD=arcadedb
ARCADEDB_GATEWAY_DB=gateway

# OpenAI - chunking, embeddings, agent tool loop, CRM slot extract
OPENAI_API_KEY=sk-your-openai-api-key
AGENT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Redis (rate limit, conversation memory, tool cache, scrape queue, CRM workflow state)
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-jwt-secret
AES_SECRET=your-aes-secret

# Server
NODE_ENV=development
PORT=3001
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
DEFAULT_RATE_LIMIT=100
