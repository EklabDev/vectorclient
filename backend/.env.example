# Database
DATABASE_URL=postgresql://api_user:secure_password@localhost:5432/api_gateway

# OpenAI - required for schema chunking, agent tool loop, and Weaviate text2vec-openai
OPENAI_API_KEY=sk-your-openai-api-key
AGENT_MODEL=gpt-4o-mini

# Weaviate
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=your-weaviate-api-key

# Redis (rate limit, conversation memory, tool cache, scrape queue)
REDIS_URL=redis://localhost:6379

# Neo4j (knowledge graph for agent tools)
NEO4J_URI=bolt://localhost:7687
NEO4J_AUTH=neo4j/password

# Authentication
JWT_SECRET=your-jwt-secret
AES_SECRET=your-aes-secret

# Server
NODE_ENV=development
PORT=3001
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
DEFAULT_RATE_LIMIT=100
