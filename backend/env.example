# PostgreSQL
DATABASE_URL=postgresql://api_user:secure_password@localhost:5432/api_gateway

# OpenAI (chunking + native agent)
OPENAI_API_KEY=sk-your-openai-api-key
AGENT_MODEL=gpt-4o-mini

# Weaviate
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=weaviate-key

# Redis (rate limit, conversation memory, scrape queue)
REDIS_URL=redis://localhost:6379

# Neo4j (knowledge graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_AUTH=neo4j/password

# JWT & Encryption
JWT_SECRET=your-very-long-random-secret-key-change-in-production
AES_SECRET=32-character-secret-key-here!12345

# Server
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
DEFAULT_RATE_LIMIT=100
